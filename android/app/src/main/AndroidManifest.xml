<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      CALL_PHONE      : place the call directly from inside the app.
      READ_PHONE_STATE: required to enumerate the device's SIMs via
                        TelecomManager.getCallCapablePhoneAccounts(). Without
                        it we cannot tell single-SIM from dual-SIM and cannot
                        target a specific SIM.

      NOTE: we deliberately do NOT request READ_CALL_LOG. Google Play restricts
      it to default-dialer apps, and requesting it is the fastest way to get a
      telecalling app rejected. Call duration is therefore not auto-captured.
    -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!--
      SEND_SMS: alongside placing the call, the app texts the Apply Card
      link (cardadda.in) to the lead's number — see
      SimManager.sendApplyCardSms(). Requested in the same prompt as
      CALL_PHONE/READ_PHONE_STATE (LeadDetailScreen's callPerms array), so
      it's one ask, not a separate one. Sent through the normal platform
      SmsManager API — it lands in the phone's own Sent folder like any
      other text this device sends; nothing about it is hidden.
    -->
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!--
      Callback reminders (Call Later): a local notification fired by
      AlarmManager at the time the agent picked.
        POST_NOTIFICATIONS   : required on Android 13+ to show it at all;
                                requested at runtime, right when the agent
                                saves a Call Later outcome.
        SCHEDULE_EXACT_ALARM : lets the reminder fire close to the exact
                                time under Doze. CallbackScheduler checks
                                canScheduleExactAlarms() and falls back to
                                an inexact alarm rather than none if this
                                is withheld.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <uses-feature android:name="android.hardware.telephony" android:required="true" />

    <!-- Android 11+ package visibility: needed to resolve the dialer, and
         (below) a browser for the "Apply Card" tab's link to cardadda.in. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".TelecallApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Telecalling">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Telecalling">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Tapping a callback reminder while the app is already running
             must land in this same instance (via onNewIntent), not stack a
             second one — hence singleTask above. -->
        <receiver
            android:name=".call.CallbackAlarmReceiver"
            android:exported="false" />

    </application>

</manifest>
